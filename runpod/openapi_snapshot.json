 "v2": {
  "paths": {
   "/v2/account/ssh-keys": [
    "get"
   ],
   "/v2/catalog/gpus": [
    "get"
   ],
   "/v2/network-volumes": [
    "get",
    "post"
   ],
   "/v2/pods": [
    "get",
    "post"
   ],
   "/v2/pods/{id}": [
    "delete",
    "get",
    "patch"
   ],
   "/v2/pods/{id}/action": [
    "post"
   ]
  },
  "schemas": {
   "BaseContainerConfig": {
    "properties": {
     "args": {
      "type": "string"
     },
     "cmd": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "disk": {
      "minimum": 1,
      "type": "integer"
     },
     "entrypoint": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "env": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "image": {
      "type": "string"
     },
     "ports": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "BaseCpuConfig": {
    "properties": {
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "vcpuCount": {
      "minimum": 2,
      "type": "integer"
     }
    },
    "required": [
     "id",
     "vcpuCount"
    ],
    "type": "object"
   },
   "BaseGpuConfig": {
    "properties": {
     "count": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "Cloud": {
    "enum": [
     "SECURE",
     "COMMUNITY"
    ],
    "type": "string"
   },
   "ContainerConfig": {
    "allOf": [
     {
      "$ref": "#/components/schemas/BaseContainerConfig"
     },
     {
      "properties": {
       "registry": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     }
    ]
   },
   "CreateCpuConfig": {
    "allOf": [
     {
      "$ref": "#/components/schemas/BaseCpuConfig"
     }
    ],
    "unevaluatedProperties": false
   },
   "CreateGpuConfig": {
    "allOf": [
     {
      "$ref": "#/components/schemas/BaseGpuConfig"
     },
     {
      "properties": {
       "allowedCudaVersions": {
        "items": {
         "pattern": "^\\d+\\.\\d+$",
         "type": "string"
        },
        "type": "array"
       },
       "minCudaVersion": {
        "pattern": "^\\d+\\.\\d+$",
        "type": "string"
       },
       "minRamPerGpu": {
        "minimum": 1,
        "type": "integer"
       },
       "minVcpuCountPerGpu": {
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     }
    ],
    "unevaluatedProperties": false
   },
   "CreatePodRequest": {
    "allOf": [
     {
      "$ref": "#/components/schemas/ContainerConfig"
     },
     {
      "properties": {
       "cloud": {
        "allOf": [
         {
          "$ref": "#/components/schemas/Cloud"
         }
        ],
        "default": "SECURE"
       },
       "cpu": {
        "$ref": "#/components/schemas/CreateCpuConfig"
       },
       "dataCenterIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "globalNetworking": {
        "default": false,
        "type": "boolean"
       },
       "gpu": {
        "$ref": "#/components/schemas/CreateGpuConfig"
       },
       "mounts": {
        "$ref": "#/components/schemas/Mounts"
       },
       "name": {
        "minLength": 1,
        "type": "string"
       },
       "startJupyter": {
        "default": false,
        "type": "boolean"
       },
       "startSsh": {
        "default": false,
        "type": "boolean"
       },
       "templateId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     }
    ],
    "if": {
     "not": {
      "required": [
       "templateId"
      ]
     }
    },
    "then": {
     "required": [
      "image"
     ]
    },
    "unevaluatedProperties": false
   },
   "Mounts": {
    "additionalProperties": false,
    "properties": {
     "network": {
      "items": {
       "$ref": "#/components/schemas/NetworkMount"
      },
      "maxItems": 1,
      "type": "array"
     },
     "persistent": {
      "$ref": "#/components/schemas/PersistentMount"
     }
    },
    "type": "object"
   },
   "NetworkMount": {
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string"
     },
     "volumeId": {
      "type": "string"
     }
    },
    "required": [
     "volumeId",
     "path"
    ],
    "type": "object"
   },
   "PersistentMount": {
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string"
     },
     "size": {
      "minimum": 10,
      "type": "integer"
     }
    },
    "required": [
     "size",
     "path"
    ],
    "type": "object"
   },
   "PodAction": {
    "enum": [
     "start",
     "stop",
     "restart",
     "terminate"
    ],
    "type": "string"
   },
   "PodActionRequest": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "$ref": "#/components/schemas/PodAction"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   }
  },
  "server": "https://api.runpod.io"
 }
}
